{% liquid
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign collections_list = section.settings.collection_list
  assign columns = section.settings.columns
  assign show_description = section.settings.show_description
  assign show_button = section.settings.show_button
  assign button_text = section.settings.button_text
  assign card_height = section.settings.card_height
  assign overlay_opacity = section.settings.overlay_opacity
  assign section_id = section.id
%}

<div
  class="collections-showcase section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style"
  style="
    {% render 'spacing-style', settings: section.settings %}
    --cs-columns: {{ columns }};
    --cs-card-height: {{ card_height }}px;
    --cs-overlay-opacity: {{ overlay_opacity | divided_by: 100.0 }};
    --cs-gap: {{ section.settings.columns_gap }}px;
  "
  data-section-id="{{ section_id }}"
>
  {% if heading != blank or subheading != blank %}
    <div class="collections-showcase__header">
      {% if heading != blank %}
        <h2 class="collections-showcase__title">{{ heading }}</h2>
      {% endif %}
      {% if subheading != blank %}
        <p class="collections-showcase__subtitle">{{ subheading }}</p>
      {% endif %}
    </div>
  {% endif %}

  <div class="collections-showcase__carousel-wrapper" data-carousel-id="cs-{{ section_id }}">
    <div class="collections-showcase__carousel" id="cs-carousel-{{ section_id }}">
      {% if collections_list != blank %}
        {% for collection in collections_list %}
          <div class="collections-showcase__card">
            <a href="{{ collection.url }}" class="collections-showcase__card-link">
              <div class="collections-showcase__card-image">
                {% if collection.image != blank %}
                  {{ collection.image | image_url: width: 1000 | image_tag:
                    loading: 'lazy',
                    class: 'collections-showcase__img',
                    widths: '300,600,800',
                    sizes: '(min-width: 750px) calc(100vw / var(--cs-columns)), 80vw'
                  }}
                {% else %}
                  {{ 'collection-1' | placeholder_svg_tag: 'collections-showcase__placeholder' }}
                {% endif %}
                <div class="collections-showcase__overlay"></div>
              </div>
              <div class="collections-showcase__card-content">
                <h3 class="collections-showcase__card-title">{{ collection.title }}</h3>
                {% if show_description and collection.description != blank %}
                  <p class="collections-showcase__card-description">
                    {{ collection.description | strip_html | truncate: 120 }}
                  </p>
                {% endif %}
                {% if show_button %}
                  <span class="collections-showcase__card-button">
                    {{ button_text | default: 'SHOP NOW' }}
                  </span>
                {% endif %}
              </div>
            </a>
          </div>
        {% endfor %}
      {% else %}
        {% for i in (1..columns) %}
          <div class="collections-showcase__card">
            <div class="collections-showcase__card-image">
              {{ 'collection-1' | placeholder_svg_tag: 'collections-showcase__placeholder' }}
              <div class="collections-showcase__overlay"></div>
            </div>
            <div class="collections-showcase__card-content">
              <h3 class="collections-showcase__card-title">Collection {{ i }}</h3>
              <p class="collections-showcase__card-description">
                Add a description for this collection
              </p>
              <span class="collections-showcase__card-button">SHOP NOW</span>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>

    {% if section.settings.show_arrows %}
      <button
        class="collections-showcase__arrow collections-showcase__arrow--prev"
        aria-label="Previous"
        data-direction="prev"
        data-carousel="cs-carousel-{{ section_id }}"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>
      <button
        class="collections-showcase__arrow collections-showcase__arrow--next"
        aria-label="Next"
        data-direction="next"
        data-carousel="cs-carousel-{{ section_id }}"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"></polyline></svg>
      </button>
    {% endif %}
  </div>
</div>

<script>
  (function() {
    const wrapper = document.querySelector('[data-carousel-id="cs-{{ section_id }}"]');
    if (!wrapper) return;

    const carousel = wrapper.querySelector('.collections-showcase__carousel');
    const prevBtn = wrapper.querySelector('[data-direction="prev"]');
    const nextBtn = wrapper.querySelector('[data-direction="next"]');

    if (!carousel) return;

    function getScrollAmount() {
      const card = carousel.querySelector('.collections-showcase__card');
      if (!card) return 300;
      return card.offsetWidth + parseInt(getComputedStyle(carousel).gap || 0);
    }

    function updateArrows() {
      if (!prevBtn || !nextBtn) return;
      prevBtn.disabled = carousel.scrollLeft <= 5;
      nextBtn.disabled = carousel.scrollLeft + carousel.offsetWidth >= carousel.scrollWidth - 5;
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', function() {
        carousel.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', function() {
        carousel.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
      });
    }

    carousel.addEventListener('scroll', updateArrows);
    updateArrows();

    if (typeof ResizeObserver !== 'undefined') {
      new ResizeObserver(updateArrows).observe(carousel);
    }
  })();
</script>

{% stylesheet %}
  .collections-showcase {
    position: relative;
    overflow: hidden;
  }

  .collections-showcase__header {
    margin-bottom: 16px;
  }

  .collections-showcase__title {
    font-family: var(--font-heading--family);
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin: 0 0 4px;
  }

  .collections-showcase__subtitle {
    font-family: var(--font-body--family);
    font-size: 0.95rem;
    margin: 0;
    opacity: 0.8;
  }

  .collections-showcase__carousel-wrapper {
    position: relative;
  }

  .collections-showcase__carousel {
    display: flex;
    gap: var(--cs-gap, 12px);
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 4px;
  }

  .collections-showcase__carousel::-webkit-scrollbar {
    display: none;
  }

  .collections-showcase__card {
    flex: 0 0 calc((100% - (var(--cs-columns, 5) - 1) * var(--cs-gap, 12px)) / var(--cs-columns, 5));
    min-width: 220px;
    scroll-snap-align: start;
    position: relative;
    border-radius: var(--cs-border-radius, 0px);
    overflow: hidden;
  }

  .collections-showcase__card-link {
    text-decoration: none;
    color: inherit;
    display: block;
    position: relative;
    height: 100%;
  }

  .collections-showcase__card-image {
    position: relative;
    width: 100%;
    height: var(--cs-card-height, 380px);
    overflow: hidden;
    background: #1a1a1a;
  }

  .collections-showcase__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .collections-showcase__card:hover .collections-showcase__img {
    transform: scale(1.05);
  }

  .collections-showcase__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collections-showcase__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, var(--cs-overlay-opacity, 0.55)) 0%, rgba(0, 0, 0, 0.1) 50%, transparent 100%);
    pointer-events: none;
  }

  .collections-showcase__card-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 24px 20px;
    color: #fff;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 8px;
  }

  .collections-showcase__card-title {
    font-family: var(--font-heading--family);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0;
    color: #fff;
  }

  .collections-showcase__card-description {
    font-family: var(--font-body--family);
    font-size: 0.8rem;
    line-height: 1.4;
    margin: 0;
    opacity: 0.9;
    color: #fff;
    max-width: 280px;
  }

  .collections-showcase__card-button {
    display: inline-block;
    margin-top: 4px;
    padding: 8px 20px;
    background: #fff;
    color: #000;
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .collections-showcase__card:hover .collections-showcase__card-button {
    background: #000;
    color: #fff;
  }

  /* Arrows */
  .collections-showcase__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    background: rgba(255, 255, 255, 0.9);
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s ease, background 0.2s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .collections-showcase__arrow:hover {
    background: #fff;
  }

  .collections-showcase__arrow:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .collections-showcase__arrow--prev {
    left: 12px;
  }

  .collections-showcase__arrow--next {
    right: 12px;
  }

  .collections-showcase__arrow svg {
    width: 20px;
    height: 20px;
  }

  /* Mobile */
  @media screen and (max-width: 749px) {
    .collections-showcase__card {
      flex: 0 0 50vw;
      min-width: 215px;
    }

    .collections-showcase__title {
      font-size: 1.35rem;
    }

    .collections-showcase__card-image {
      height: calc(var(--cs-card-height, 380px) * 0.8);
    }

    .collections-showcase__arrow {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collections Showcase",
  "class": "collections-showcase-section",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Collection"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Find your perfect fit"
    },
    {
      "type": "collection_list",
      "id": "collection_list",
      "label": "Collections"
    },
    {
      "type": "header",
      "content": "Card settings"
    },
    {
      "type": "range",
      "id": "card_height",
      "label": "Card height",
      "min": 200,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 400
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show collection description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show button",
      "default": true
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "SHOP NOW"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 55
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_gap",
      "label": "Gap between cards",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show navigation arrows",
      "default": true
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "full-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Collections Showcase",
      "category": "Collections"
    }
  ]
}
{% endschema %}
