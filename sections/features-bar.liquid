{% comment %}
  Features Bar Section
  Displays a horizontal bar with customizable feature/benefit items (icon + text).
  Responsive: 4 columns on desktop, 2 on tablet, 1 on mobile.
{% endcomment %}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<div
  class="features-bar color-{{ section.settings.color_scheme }}"
  style="
    --features-bar-padding-top: {{ section.settings.padding_top }}px;
    --features-bar-padding-bottom: {{ section.settings.padding_bottom }}px;
    --features-bar-columns: {{ section.blocks.size | at_least: 1 }};
    --features-bar-gap: {{ section.settings.gap }}px;
    --features-bar-icon-size: {{ section.settings.icon_size }}px;
    --features-bar-icon-color: {{ section.settings.icon_color }};
    --features-bar-title-size: {{ section.settings.title_size }}px;
    --features-bar-subtitle-size: {{ section.settings.subtitle_size }}px;
    --features-bar-alignment: {{ section.settings.text_alignment }};
    --features-bar-divider-color: {{ section.settings.divider_color }};
    --features-bar-divider-width: {{ section.settings.divider_width }}px;
  "
>
  <div class="features-bar__inner page-width">
    {%- for block in section.blocks -%}
      {%- assign icon = block.settings.icon -%}

      <div
        class="features-bar__item"
        {{ block.shopify_attributes }}
        {% if section.settings.show_dividers and forloop.last == false %}
          data-has-divider="true"
        {% endif %}
      >
        {%- comment -%} Icon {%- endcomment -%}
        {%- if block.settings.custom_icon != blank -%}
          <div class="features-bar__icon">
            <img
              src="{{ block.settings.custom_icon | image_url: width: 80 }}"
              alt="{{ block.settings.title | escape }}"
              width="{{ section.settings.icon_size }}"
              height="{{ section.settings.icon_size }}"
              loading="lazy"
            >
          </div>
        {%- elsif icon != 'none' -%}
          <div class="features-bar__icon" aria-hidden="true">
            {%- case icon -%}
              {%- when 'award' -%}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"/></svg>
              {%- when 'heart' -%}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
              {%- when 'truck' -%}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 5v3h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              {%- when 'dollar' -%}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              {%- when 'star' -%}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              {%- when 'shield' -%}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              {%- when 'gift' -%}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
              {%- when 'refresh' -%}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
              {%- when 'lock' -%}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              {%- when 'tag' -%}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
              {%- when 'headphones' -%}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3z"/><path d="M3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/></svg>
              {%- when 'check-circle' -%}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            {%- endcase -%}
          </div>
        {%- endif -%}

        {%- comment -%} Text {%- endcomment -%}
        <div class="features-bar__text">
          {%- if block.settings.title != blank -%}
            <p class="features-bar__title">{{ block.settings.title | escape }}</p>
          {%- endif -%}
          {%- if block.settings.subtitle != blank -%}
            <p class="features-bar__subtitle">{{ block.settings.subtitle | escape }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .features-bar {
    padding-block-start: var(--features-bar-padding-top, 24px);
    padding-block-end: var(--features-bar-padding-bottom, 24px);
  }

  .features-bar__inner {
    display: grid;
    grid-template-columns: repeat(var(--features-bar-columns, 4), 1fr);
    gap: var(--features-bar-gap, 24px);
    align-items: start;
  }

  .features-bar__item {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 16px;
    text-align: var(--features-bar-alignment, left);
    position: relative;
    margin:0 auto;
  }

  .features-bar__item[data-has-divider="true"]::after {
    content: '';
    position: absolute;
    inset-inline-end: calc(var(--features-bar-gap, 24px) / -2);
    top: 10%;
    height: 80%;
    width: var(--features-bar-divider-width, 1px);
    background-color: var(--features-bar-divider-color, var(--color-border));
  }

  .features-bar__icon {
    flex-shrink: 0;
    width: var(--features-bar-icon-size, 40px);
    height: var(--features-bar-icon-size, 40px);
    color: var(--features-bar-icon-color, var(--color-foreground));
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .features-bar__icon svg,
  .features-bar__icon img {
    width: 100%;
    height: 100%;
    display: block;
  }

  .features-bar__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .features-bar__title {
    margin: 0;
    font-size: var(--features-bar-title-size, 14px);
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-foreground-heading);
  }

  .features-bar__subtitle {
    margin: 0;
    font-size: var(--features-bar-subtitle-size, 12px);
    line-height: 1.4;
    color: var(--color-foreground);
    opacity: 0.7;
  }

  /* Tablet: 2 columns */
  @media screen and (max-width: 989px) and (min-width: 750px) {
    .features-bar__inner {
      grid-template-columns: repeat(2, 1fr);
    }

    .features-bar__item[data-has-divider="true"]::after {
      display: none;
    }
  }

  /* Mobile: 1 column or 2 based on count */
  @media screen and (max-width: 749px) {
    .features-bar__inner {
      grid-template-columns: repeat(2, 1fr);
      gap: calc(var(--features-bar-gap, 24px) * 0.75);
    }

    .features-bar__item {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 10px;
    }

    .features-bar__item[data-has-divider="true"]::after {
      display: none;
    }

    .features-bar__icon {
      width: calc(var(--features-bar-icon-size, 40px) * 0.9);
      height: calc(var(--features-bar-icon-size, 40px) * 0.9);
    }
  }

  @media screen and (max-width: 480px) {
    .features-bar__inner {
      grid-template-columns: 1fr;
    }

    .features-bar__item {
      flex-direction: row;
      align-items: center;
      text-align: left;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Features Bar",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "feature_item",
      "name": "Feature Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "award", "label": "Award / Badge" },
            { "value": "heart", "label": "Heart" },
            { "value": "truck", "label": "Truck / Shipping" },
            { "value": "dollar", "label": "Dollar / Price" },
            { "value": "star", "label": "Star" },
            { "value": "shield", "label": "Shield / Security" },
            { "value": "gift", "label": "Gift" },
            { "value": "refresh", "label": "Return / Exchange" },
            { "value": "lock", "label": "Lock / Privacy" },
            { "value": "tag", "label": "Tag / Offer" },
            { "value": "headphones", "label": "Headphones / Support" },
            { "value": "check-circle", "label": "Check Circle" }
          ],
          "default": "award"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom Icon Image",
          "info": "Overrides the selected icon above if uploaded."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature Title"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Short description of the feature"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon Color",
      "default": "#000F9F"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title Font Size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "label": "Subtitle Font Size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Icon"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon Size",
      "min": 20,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Dividers"
    },
    {
      "type": "checkbox",
      "id": "show_dividers",
      "label": "Show Dividers Between Items",
      "default": true
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider Color",
      "default": "#E6E6E6"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "Divider Width",
      "min": 1,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap Between Items",
      "min": 8,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Features Bar",
      "category": "Promotional",
      "blocks": [
        {
          "type": "feature_item",
          "settings": {
            "icon": "award",
            "title": "20 Years Trusted Experience",
            "subtitle": "Serving customers since 2004"
          }
        },
        {
          "type": "feature_item",
          "settings": {
            "icon": "heart",
            "title": "We Care! Excellent Customer Service",
            "subtitle": "Always here to help you"
          }
        },
        {
          "type": "feature_item",
          "settings": {
            "icon": "truck",
            "title": "Fast Shipping & Logistics",
            "subtitle": "Quick delivery to your door"
          }
        },
        {
          "type": "feature_item",
          "settings": {
            "icon": "dollar",
            "title": "Rewards Save As You Spend",
            "subtitle": "Earn points with every purchase"
          }
        }
      ]
    }
  ]
}
{% endschema %}
