
<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} stf-footer spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
  {{ section.shopify_attributes }}
>

  {%- comment -%} ──────────────── TOP GRID: 4 columns ──────────────── {%- endcomment -%}
  <div class="stf-footer__grid">

    {%- comment -%} COLUMN 1 – Contáctanos {%- endcomment -%}
    <div class="stf-footer__col">
      {% if section.settings.contact_heading != blank %}
        <h3 class="stf-footer__col-heading">{{ section.settings.contact_heading | escape }}</h3>
      {% endif %}

      {% if section.settings.contact_phone != blank %}
        <a class="stf-footer__contact-link" href="tel:{{ section.settings.contact_phone | remove: ' ' }}">
          <svg class="stf-footer__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"/>
          </svg>
          {{ section.settings.contact_phone | escape }}
        </a>
      {% endif %}

      {% if section.settings.contact_email != blank %}
        <a class="stf-footer__contact-link" href="mailto:{{ section.settings.contact_email }}">
          <svg class="stf-footer__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"/>
          </svg>
          {{ section.settings.contact_email | escape }}
        </a>
      {% endif %}
    </div>

    {%- comment -%} COLUMN 2 – Sucursales {%- endcomment -%}
    <div class="stf-footer__col">
      {% if section.settings.branches_heading != blank %}
        <h3 class="stf-footer__col-heading">{{ section.settings.branches_heading | escape }}</h3>
      {% endif %}

      {%- for i in (1..2) -%}
        {%- liquid
          assign name_key    = 'branch_' | append: i | append: '_name'
          assign address_key = 'branch_' | append: i | append: '_address'
          assign hours_key   = 'branch_' | append: i | append: '_hours'
          assign name    = section.settings[name_key]
          assign address = section.settings[address_key]
          assign hours   = section.settings[hours_key]
        -%}
        {% if name != blank or address != blank %}
          <div class="stf-footer__branch{% if i > 1 %} stf-footer__branch--separator{% endif %}">
            {% if name != blank %}
              <p class="stf-footer__branch-name">{{ name | escape }}</p>
            {% endif %}
            {% if address != blank %}
              <p class="stf-footer__branch-address">{{ address | escape }}</p>
            {% endif %}
            {% if hours != blank %}
              <p class="stf-footer__branch-hours">{{ hours | escape }}</p>
            {% endif %}
          </div>
        {% endif %}
      {%- endfor -%}
    </div>

    {%- comment -%} COLUMN 3 – Información (navigation menu) {%- endcomment -%}
    <div class="stf-footer__col">
      {% if section.settings.info_heading != blank %}
        <h3 class="stf-footer__col-heading">{{ section.settings.info_heading | escape }}</h3>
      {% endif %}

      {% if section.settings.info_menu != blank %}
        <ul class="stf-footer__menu list-unstyled">
          {% for link in section.settings.info_menu.links %}
            <li class="stf-footer__menu-item">
              <a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>
                {{ link.title }}
              </a>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>

    {%- comment -%} COLUMN 4 – Regístrate (newsletter) {%- endcomment -%}
    <div class="stf-footer__col">
      {% if section.settings.newsletter_heading != blank %}
        <h3 class="stf-footer__col-heading">{{ section.settings.newsletter_heading | escape }}</h3>
      {% endif %}

      {% if section.settings.newsletter_description != blank %}
        <p class="stf-footer__newsletter-desc">{{ section.settings.newsletter_description | escape }}</p>
      {% endif %}

      {% if section.settings.newsletter_type == 'phone' %}
        {%- comment -%} Phone SMS opt-in form {%- endcomment -%}
        <form
          class="stf-footer__form"
          action="{{ routes.root_url }}"
          method="post"
          data-type="phone-signup"
          novalidate
        >
          <input type="hidden" name="form_type" value="contact">
          <input type="hidden" name="utf8" value="✓">
          <div class="stf-footer__input-wrap">
            <label for="StfFooterPhone-{{ section.id }}" class="visually-hidden">
              {{ section.settings.newsletter_placeholder | default: 'Número de teléfono' }}
            </label>
            <input
              id="StfFooterPhone-{{ section.id }}"
              class="stf-footer__input"
              type="tel"
              name="contact[phone]"
              placeholder="{{ section.settings.newsletter_placeholder | default: 'Número de teléfono' | escape }}"
              autocomplete="tel"
              required
            >
            <button class="stf-footer__submit button" type="submit">
              {{ section.settings.newsletter_button_label | default: 'ENVIAR' | escape }}
            </button>
          </div>
        </form>
      {% else %}
        {%- comment -%} Email newsletter form using Shopify customer subscribe {%- endcomment -%}
        {%- form 'customer', class: 'stf-footer__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input type="hidden" name="contact[accepts_marketing]" value="true">
          <div class="stf-footer__input-wrap">
            <label for="StfFooterEmail-{{ section.id }}" class="visually-hidden">
              {{ section.settings.newsletter_placeholder | default: 'Tu correo electrónico' }}
            </label>
            <input
              id="StfFooterEmail-{{ section.id }}"
              class="stf-footer__input"
              type="email"
              name="contact[email]"
              placeholder="{{ section.settings.newsletter_placeholder | default: 'Tu correo electrónico' | escape }}"
              autocomplete="email"
              required
              {% if form.errors %}
                autofocus
                aria-invalid="true"
              {% endif %}
            >
            <button class="stf-footer__submit button" type="submit">
              {{ section.settings.newsletter_button_label | default: 'ENVIAR' | escape }}
            </button>
          </div>
          {%- if form.posted_successfully? -%}
            <p class="stf-footer__form-message stf-footer__form-message--success">
              {{ section.settings.newsletter_success | default: '¡Gracias por suscribirte!' }}
            </p>
          {%- endif -%}
          {%- if form.errors -%}
            <p class="stf-footer__form-message stf-footer__form-message--error">
              {{ form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email }}
            </p>
          {%- endif -%}
        {%- endform -%}
      {% endif %}
    </div>

  </div>{%- comment -%} /stf-footer__grid {%- endcomment -%}

  {%- comment -%} ──────────────── BOTTOM BAR: Logo + Social ──────────────── {%- endcomment -%}
  <div class="stf-footer__bottom">

    <div class="stf-footer__logo-wrap">
      {% if section.settings.logo_image != blank %}
        <a href="{{ routes.root_url }}" class="stf-footer__logo-link" aria-label="{{ shop.name | escape }}">
          {{
            section.settings.logo_image
            | image_url: width: 300
            | image_tag:
              alt: section.settings.logo_image.alt | default: shop.name,
              loading: 'lazy',
              class: 'stf-footer__logo-image',
              widths: '80, 120, 160, 200, 300',
              sizes: '(min-width: 750px) 160px, 120px'
          }}
        </a>
      {% elsif section.settings.logo_text != blank %}
        <a href="{{ routes.root_url }}" class="stf-footer__logo-text" aria-label="{{ shop.name | escape }}">
          {{ section.settings.logo_text | escape }}
        </a>
      {% else %}
        <a href="{{ routes.root_url }}" class="stf-footer__logo-text" aria-label="{{ shop.name | escape }}">
          {{ shop.name | escape }}
        </a>
      {% endif %}
    </div>

    <div class="stf-footer__social-wrap">
      {% if section.settings.instagram_url != blank %}
        <a
          href="{{ section.settings.instagram_url }}"
          class="stf-footer__social-link"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
        >
          <svg class="stf-footer__social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/>
          </svg>
        </a>
      {% endif %}

      {% if section.settings.facebook_url != blank %}
        <a
          href="{{ section.settings.facebook_url }}"
          class="stf-footer__social-link"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook"
        >
          <svg class="stf-footer__social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </a>
      {% endif %}

      {% if section.settings.tiktok_url != blank %}
        <a
          href="{{ section.settings.tiktok_url }}"
          class="stf-footer__social-link"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="TikTok"
        >
          <svg class="stf-footer__social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
            <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
          </svg>
        </a>
      {% endif %}

      {% if section.settings.twitter_url != blank %}
        <a
          href="{{ section.settings.twitter_url }}"
          class="stf-footer__social-link"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="X (Twitter)"
        >
          <svg class="stf-footer__social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.259 5.631 5.905-5.631zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </a>
      {% endif %}

      {% if section.settings.youtube_url != blank %}
        <a
          href="{{ section.settings.youtube_url }}"
          class="stf-footer__social-link"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="YouTube"
        >
          <svg class="stf-footer__social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
            <path d="M23.495 6.205a3.007 3.007 0 0 0-2.088-2.088c-1.87-.501-9.396-.501-9.396-.501s-7.507-.01-9.396.501A3.007 3.007 0 0 0 .527 6.205a31.247 31.247 0 0 0-.522 5.805 31.247 31.247 0 0 0 .522 5.783 3.007 3.007 0 0 0 2.088 2.088c1.868.502 9.396.502 9.396.502s7.506 0 9.396-.502a3.007 3.007 0 0 0 2.088-2.088 31.247 31.247 0 0 0 .5-5.783 31.247 31.247 0 0 0-.5-5.805zM9.609 15.601V8.408l6.264 3.602z"/>
          </svg>
        </a>
      {% endif %}
    </div>

  </div>{%- comment -%} /stf-footer__bottom {%- endcomment -%}

  {% if section.settings.show_divider %}
    <div class="stf-footer__divider"></div>
  {% endif %}

  {% if section.settings.copyright_text != blank %}
    <p class="stf-footer__copyright">{{ section.settings.copyright_text | escape }}</p>
  {% endif %}

</div>

{% stylesheet %}
  /* ──────────────────────────────────────────
     STF Footer — main layout
  ────────────────────────────────────────── */
  .stf-footer {
    --stf-footer-gap: 40px;
    --stf-footer-col-gap: 16px;
    --stf-footer-bottom-mt: 40px;
    --stf-footer-icon-size: 18px;
    --stf-footer-social-icon-size: 22px;
    --stf-footer-social-gap: 16px;
    --stf-footer-border-color: rgb(var(--color-foreground-rgb) / 0.15);
  }

  /* 4-column grid */
  .stf-footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--stf-footer-gap);
  }

  @media screen and (min-width: 750px) {
    .stf-footer__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (min-width: 990px) {
    .stf-footer__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Columns */
  .stf-footer__col {
    display: flex;
    flex-direction: column;
    gap: var(--stf-footer-col-gap);
  }

  .stf-footer__col-heading {
    font-size: 0.9375rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 4px;
    color: currentColor;
  }

  /* ── Contact column ── */
  .stf-footer__contact-link {
    display: flex;
    align-items: center;
    gap: 8px;
    color: currentColor;
    text-decoration: none;
    font-size: 0.875rem;
    word-break: break-all;
    transition: opacity 0.2s ease;
  }

  .stf-footer__contact-link:hover {
    opacity: 0.7;
  }

  .stf-footer__icon {
    flex-shrink: 0;
    width: var(--stf-footer-icon-size);
    height: var(--stf-footer-icon-size);
  }

  /* ── Branches column ── */
  .stf-footer__branch {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 0.8125rem;
  }

  .stf-footer__branch--separator {
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--stf-footer-border-color);
  }

  .stf-footer__branch-name {
    font-weight: 600;
    margin: 0;
    font-size: 0.875rem;
  }

  .stf-footer__branch-address,
  .stf-footer__branch-hours {
    margin: 0;
    opacity: 0.8;
    line-height: 1.4;
  }

  /* ── Info menu column ── */
  .stf-footer__menu {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 0;
    margin: 0;
  }

  .stf-footer__menu-item {
    font-size: 0.875rem;
  }

  .stf-footer__menu-item a {
    color: currentColor;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .stf-footer__menu-item a:hover {
    opacity: 0.7;
    text-decoration: underline;
  }

  /* ── Newsletter column ── */
  .stf-footer__newsletter-desc {
    font-size: 0.875rem;
    margin: 0;
    opacity: 0.85;
    line-height: 1.5;
  }

  .stf-footer__form {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 4px;
  }

  .stf-footer__input-wrap {
    display: flex;
    gap: 0;
    border: 1px solid var(--color-input-border, currentColor);
    border-radius: 4px;
    overflow: hidden;
  }

  .stf-footer__input {
    flex: 1;
    min-width: 0;
    padding: 10px 12px;
    border: none;
    background-color: var(--color-input-background, transparent);
    color: var(--color-input-text, currentColor);
    font-size: 0.875rem;
    outline: none;
  }

  .stf-footer__input::placeholder {
    opacity: 0.55;
  }

  .stf-footer__submit {
    flex-shrink: 0;
    padding: 10px 16px;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    cursor: pointer;
    border: none;
    border-radius: 0;
    white-space: nowrap;
  }

  .stf-footer__form-message {
    font-size: 0.8125rem;
    margin: 0;
  }

  .stf-footer__form-message--success {
    color: var(--color-success, #2a7f45);
  }

  .stf-footer__form-message--error {
    color: var(--color-error, #c0392b);
  }

  /* ──────────────────────────────────────────
     Bottom bar: Logo + Social
  ────────────────────────────────────────── */
  .stf-footer__bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    margin-top: var(--stf-footer-bottom-mt);
    padding-top: var(--stf-footer-bottom-mt);
    border-top: 1px solid var(--stf-footer-border-color);
  }

  @media screen and (min-width: 750px) {
    .stf-footer__bottom {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  /* Logo */
  .stf-footer__logo-wrap {
    display: flex;
    align-items: center;
  }

  .stf-footer__logo-text {
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: currentColor;
    transition: opacity 0.2s ease;
  }

  .stf-footer__logo-text:hover {
    opacity: 0.75;
  }

  .stf-footer__logo-link {
    display: block;
    text-decoration: none;
  }

  .stf-footer__logo-image {
    display: block;
    max-height: 60px;
    width: auto;
    object-fit: contain;
  }

  /* Social icons */
  .stf-footer__social-wrap {
    display: flex;
    align-items: center;
    gap: var(--stf-footer-social-gap);
    flex-wrap: wrap;
  }

  .stf-footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    color: currentColor;
    text-decoration: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .stf-footer__social-link:hover {
    opacity: 0.7;
    transform: translateY(-2px);
  }

  .stf-footer__social-icon {
    width: var(--stf-footer-social-icon-size);
    height: var(--stf-footer-social-icon-size);
  }

  /* ── Divider & copyright ── */
  .stf-footer__divider {
    border: none;
    border-top: 1px solid var(--stf-footer-border-color);
    margin-top: 24px;
  }

  .stf-footer__copyright {
    text-align: center;
    font-size: 0.75rem;
    margin: 16px 0 0;
    opacity: 0.65;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "STF Footer",
  "tag": "footer",
  "class": "stf-footer-section",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Apariencia"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Ancho",
      "options": [
        { "value": "page-width", "label": "Página" },
        { "value": "full-width", "label": "Completo" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Contáctanos"
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Título",
      "default": "Contáctanos"
    },
    {
      "type": "text",
      "id": "contact_phone",
      "label": "Teléfono",
      "default": "+503 7690 6326"
    },
    {
      "type": "text",
