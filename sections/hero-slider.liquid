{% liquid
  assign slides_count = section.settings.slides_count
  assign active_slides = 0
  assign widths = '832, 1200, 1600, 1920, 2560, 3840'
  assign mobile_widths = '416, 600, 800, 1200, 1600'
  assign mobile_widths_array = mobile_widths | split: ', '
  assign sizes = '100vw'
  assign sizes_mobile = '100vw'
  assign fetch_priority = 'auto'

  if section.index == 1
    assign fetch_priority = 'high'
  endif

  if section.settings.slide_1_image_desktop != blank
    assign active_slides = active_slides | plus: 1
  endif
  if slides_count >= 2 and section.settings.slide_2_image_desktop != blank
    assign active_slides = active_slides | plus: 1
  endif
  if slides_count >= 3 and section.settings.slide_3_image_desktop != blank
    assign active_slides = active_slides | plus: 1
  endif
  if slides_count >= 4 and section.settings.slide_4_image_desktop != blank
    assign active_slides = active_slides | plus: 1
  endif
  if slides_count >= 5 and section.settings.slide_5_image_desktop != blank
    assign active_slides = active_slides | plus: 1
  endif
%}

<hero-slider
  id="HeroSlider-{{ section.id }}"
  class="hero-slider color-{{ section.settings.color_scheme }}{% if section.blocks.size == 0 and section.settings.section_height == 'auto' %} hero-slider--no-blocks-auto-height{% endif %}"
  style="
    --hero-slider-border-style: {{ section.settings.border }};
    --hero-slider-border-width: {{ section.settings.border_width }}px;
    --hero-slider-border-opacity: {{ section.settings.border_opacity }}%;
    --hero-slider-speed: {{ section.settings.slider_speed }}s;
    {% if section.settings.section_height == 'custom' %}
      --hero-slider-min-height: {{ section.settings.section_height_custom }}svh;
    {% elsif section.settings.section_height == 'full-screen' %}
      --hero-slider-min-height: 100svh;
    {% else %}
      --hero-slider-min-height: var(--section-height-{{ section.settings.section_height }});
    {% endif %}
  "
  data-autoplay="{{ section.settings.slider_autoplay }}"
  data-speed="{{ section.settings.slider_speed }}"
  data-active-slides="{{ active_slides }}"
  {% if request.visual_preview_mode %}data-shopify-visual-preview{% endif %}
>
  <div
    class="hero-slider__container spacing-style section section--full-width"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    {%- comment -%} Slides {%- endcomment -%}
    <div class="hero-slider__slides" data-slides>
      {% assign slide_render_index = 0 %}

      {% for i in (1..5) %}
        {% if i > slides_count %}{% break %}{% endif %}

        {% liquid
          assign slide_visible = false
          assign slide_image_desktop = blank
          assign slide_image_mobile = blank
          assign slide_link = blank
          assign slide_open_new_tab = false

          case i
            when 1
              if section.settings.slide_1_image_desktop != blank
                assign slide_visible = true
                assign slide_image_desktop = section.settings.slide_1_image_desktop
                assign slide_image_mobile = section.settings.slide_1_image_mobile
                assign slide_link = section.settings.slide_1_link
                assign slide_open_new_tab = section.settings.slide_1_open_in_new_tab
              endif
            when 2
              if section.settings.slide_2_image_desktop != blank
                assign slide_visible = true
                assign slide_image_desktop = section.settings.slide_2_image_desktop
                assign slide_image_mobile = section.settings.slide_2_image_mobile
                assign slide_link = section.settings.slide_2_link
                assign slide_open_new_tab = section.settings.slide_2_open_in_new_tab
              endif
            when 3
              if section.settings.slide_3_image_desktop != blank
                assign slide_visible = true
                assign slide_image_desktop = section.settings.slide_3_image_desktop
                assign slide_image_mobile = section.settings.slide_3_image_mobile
                assign slide_link = section.settings.slide_3_link
                assign slide_open_new_tab = section.settings.slide_3_open_in_new_tab
              endif
            when 4
              if section.settings.slide_4_image_desktop != blank
                assign slide_visible = true
                assign slide_image_desktop = section.settings.slide_4_image_desktop
                assign slide_image_mobile = section.settings.slide_4_image_mobile
                assign slide_link = section.settings.slide_4_link
                assign slide_open_new_tab = section.settings.slide_4_open_in_new_tab
              endif
            when 5
              if section.settings.slide_5_image_desktop != blank
                assign slide_visible = true
                assign slide_image_desktop = section.settings.slide_5_image_desktop
                assign slide_image_mobile = section.settings.slide_5_image_mobile
                assign slide_link = section.settings.slide_5_link
                assign slide_open_new_tab = section.settings.slide_5_open_in_new_tab
              endif
          endcase
        %}

        {% if slide_visible %}
          <div
            class="hero-slider__slide{% if slide_render_index == 0 %} hero-slider__slide--active{% endif %}"
            data-slide-index="{{ slide_render_index }}"
            aria-hidden="{% if slide_render_index == 0 %}false{% else %}true{% endif %}"
          >
            {%- if slide_link != blank -%}
              <a
                href="{{ slide_link }}"
                class="hero-slider__slide-link"
                {% if slide_open_new_tab %}target="_blank" rel="noopener"{% endif %}
                aria-label="Slide {{ i }}"
              ></a>
            {%- endif -%}

            <div class="hero-slider__media-wrapper">
              {%- if section.settings.toggle_overlay -%}
                {%- render 'overlay', settings: section.settings -%}
              {%- endif -%}

              {%- assign slide_fetch_priority = 'lazy' -%}
              {%- if slide_render_index == 0 -%}
                {%- assign slide_fetch_priority = fetch_priority -%}
              {%- endif -%}

              {%- if slide_image_mobile != blank -%}
                <picture class="hero-slider__picture">
                  <source
                    media="(max-width: 749px)"
                    srcset="
                      {%- for mobile_width in mobile_widths_array -%}
                        {{ slide_image_mobile | image_url: width: mobile_width }} {{ mobile_width }}w{% unless forloop.last %},{% endunless %}
                      {%- endfor -%}
                    "
                    sizes="{{ sizes_mobile }}"
                    width="{{ slide_image_mobile.width }}"
                    height="{{ slide_image_mobile.height }}"
                  >
                  {{
                    slide_image_desktop
                    | image_url: width: 3840
                    | image_tag:
                      width: slide_image_desktop.width,
                      widths: widths,
                      height: slide_image_desktop.height,
                      alt: slide_image_desktop.alt,
                      class: 'hero-slider__image',
                      sizes: sizes,
                      fetchpriority: slide_fetch_priority,
                      loading: 'eager'
                  }}
                </picture>
              {%- else -%}
                {{
                  slide_image_desktop
                  | image_url: width: 3840
                  | image_tag:
                    width: slide_image_desktop.width,
                    widths: widths,
                    height: slide_image_desktop.height,
                    alt: slide_image_desktop.alt,
                    class: 'hero-slider__image',
                    sizes: sizes,
                    fetchpriority: slide_fetch_priority,
                    loading: 'eager'
                }}
              {%- endif -%}
            </div>
          </div>

          {% assign slide_render_index = slide_render_index | plus: 1 %}
        {% endif %}
      {% endfor %}

      {%- if active_slides == 0 -%}
        <div class="hero-slider__slide hero-slider__slide--active" data-slide-index="0" aria-hidden="false">
          <div class="hero-slider__media-wrapper">
            {{ 'hero-apparel-1' | placeholder_svg_tag: 'hero-slider__image' }}
          </div>
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Content overlay (text, buttons, etc.) {%- endcomment -%}
    <div
      class="
        hero-slider__content-wrapper
        layout-panel-flex
        layout-panel-flex--{{ section.settings.content_direction }}
        {% if section.settings.vertical_on_mobile %}mobile-column{% endif %}
        section-content-wrapper
        {{ section.settings.section_width }}
        {% if request.design_mode %}hero-slider__content-wrapper--design-mode{% endif %}
      "
      style="{% render 'layout-panel-style', settings: section.settings %}"
    >
      {% content_for 'blocks' %}
    </div>

    {%- comment -%} Navigation: arrows and dots {%- endcomment -%}
    {%- if active_slides > 1 -%}
      {%- if section.settings.slider_show_arrows -%}
        <button
          class="hero-slider__arrow hero-slider__arrow--prev"
          data-prev
          aria-label="Slide anterior"
          type="button"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button
          class="hero-slider__arrow hero-slider__arrow--next"
          data-next
          aria-label="Siguiente slide"
          type="button"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      {%- endif -%}

      {%- if section.settings.slider_show_dots -%}
        <div class="hero-slider__dots" data-dots role="tablist" aria-label="Slides de navegación">
          {%- for d in (1..active_slides) -%}
            <button
              class="hero-slider__dot{% if forloop.first %} hero-slider__dot--active{% endif %}"
              data-dot-index="{{ forloop.index0 }}"
              role="tab"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-label="Ir al slide {{ forloop.index }}"
              type="button"
            >
              <svg class="hero-slider__dot-svg" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <circle class="hero-slider__dot-bg" cx="12" cy="12" r="5"/>
                <circle class="hero-slider__dot-progress" cx="12" cy="12" r="10"/>
              </svg>
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</hero-slider>

{% stylesheet %}
  .hero-slider {
    position: relative;
    min-height: calc(var(--hero-slider-min-height) - var(--hero-height-offset, 0px));
  }

  .hero-slider[data-shopify-visual-preview] {
    --hero-slider-min-height: 600px;
    min-height: 600px;
  }

  .hero-slider__container {
    position: relative;
    overflow: hidden;
    border: var(--hero-slider-border-width) var(--hero-slider-border-style) rgb(var(--color-border-rgb) / var(--hero-slider-border-opacity));
    min-height: inherit;
    align-items: var(--vertical-alignment-mobile);
    justify-content: var(--horizontal-alignment);
    z-index: var(--layer-base);

    @media screen and (min-width: 750px) {
      align-items: var(--vertical-alignment);
    }
  }

  /* Slides */
  .hero-slider__slides {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-slider__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.7s ease;
    pointer-events: none;
  }

  .hero-slider__slide--active {
    opacity: 1;
    pointer-events: auto;
  }

  .hero-slider__media-wrapper {
    position: absolute;
    inset: 0;
  }

  .hero-slider__image,
  .hero-slider__picture {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }

  .hero-slider__picture img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }

  .hero-slider--no-blocks-auto-height {
    .hero-slider__image,
    .hero-slider__picture {
      aspect-ratio: auto;
    }

    .hero-slider__slides {
      position: relative;
    }
  }

  /* Slide link overlay */
  .hero-slider__slide-link {
    position: absolute;
    inset: 0;
    z-index: var(--layer-flat);
  }

  /* Content wrapper */
  .hero-slider__content-wrapper {
    position: relative;
    inset: 0;
    z-index: var(--layer-raised);
  }

  .hero-slider__content-wrapper.page-width {
    grid-column: 2 / 3;
  }

  .hero-slider__content-wrapper .group-block-content {
    position: relative;
  }

  .hero-slider__content-wrapper,
  .hero-slider__slides {
    pointer-events: none;

    :is(a, button, input, textarea, select) {
      pointer-events: auto;
    }
  }

  .hero-slider__content-wrapper--design-mode * {
    pointer-events: auto;
  }

  /* Arrows */
  .hero-slider__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: var(--layer-raised);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: rgb(255 255 255 / 0.8);
    color: #000;
    border: none;
    border-radius: 50%;
    cursor: pointer;
    transition: background 0.2s ease, opacity 0.2s ease;
    pointer-events: auto;

    &:hover {
      background: rgb(255 255 255 / 1);
    }
  }

  .hero-slider__arrow--prev {
    left: 16px;
  }

  .hero-slider__arrow--next {
    right: 16px;
  }

  @media screen and (max-width: 749px) {
    .hero-slider__arrow {
      width: 36px;
      height: 36px;
    }

    .hero-slider__arrow--prev {
      left: 10px;
    }

    .hero-slider__arrow--next {
      right: 10px;
    }
  }

  /* Dots */
  .hero-slider__dots {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: var(--layer-raised);
    display: flex;
    align-items: center;
    gap: 10px;
    pointer-events: auto;
  }

  .hero-slider__dot {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
  }

  .hero-slider__dot-svg {
    width: 24px;
    height: 24px;
    overflow: visible;
  }

  .hero-slider__dot-bg {
    fill: rgb(255 255 255 / 0.5);
    transition: fill 0.2s ease;
  }

  .hero-slider__dot--active .hero-slider__dot-bg {
    fill: rgb(255 255 255 / 0.9);
  }

  /* Progress ring around active dot */
  .hero-slider__dot-progress {
    fill: none;
    stroke: rgb(255 255 255 / 0.9);
    stroke-width: 1.5;
    stroke-dasharray: 62.83;
    stroke-dashoffset: 62.83;
    transform-origin: 12px 12px;
    transform: rotate(-90deg);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .hero-slider__dot--active .hero-slider__dot-progress {
    opacity: 1;
    animation: hero-slider-dot-progress var(--hero-slider-speed, 5s) linear forwards;
  }

  @keyframes hero-slider-dot-progress {
    from { stroke-dashoffset: 62.83; }
    to { stroke-dashoffset: 0; }
  }
{% endstylesheet %}

{% javascript %}
  class HeroSlider extends HTMLElement {
    constructor() {
      super();
      this.currentIndex = 0;
      this.autoplayTimer = null;
      this.touchStartX = 0;
      this.touchEndX = 0;
      this.isTransitioning = false;
    }

    connectedCallback() {
      this.slides = this.querySelectorAll('[data-slide-index]');
      this.dots = this.querySelectorAll('[data-dot-index]');
      this.totalSlides = parseInt(this.dataset.activeSlides) || 1;
      this.autoplay = this.dataset.autoplay === 'true';
      this.speed = (parseFloat(this.dataset.speed) || 5) * 1000;

      if (this.totalSlides <= 1) return;

      const prevBtn = this.querySelector('[data-prev]');
      const nextBtn = this.querySelector('[data-next]');

      if (prevBtn) prevBtn.addEventListener('click', () => this.prev());
      if (nextBtn) nextBtn.addEventListener('click', () => this.next());

      this.dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          this.goToSlide(parseInt(dot.dataset.dotIndex));
        });
      });

      this.addEventListener('touchstart', (e) => {
        this.touchStartX = e.changedTouches[0].screenX;
      }, { passive: true });

      this.addEventListener('touchend', (e) => {
        this.touchEndX = e.changedTouches[0].screenX;
        const diff = this.touchStartX - this.touchEndX;
        if (Math.abs(diff) > 50) {
          if (diff > 0) this.next();
          else this.prev();
        }
      }, { passive: true });

      this.addEventListener('mouseenter', () => this.stopAutoplay());
      this.addEventListener('mouseleave', () => { if (this.autoplay) this.startAutoplay(); });

      if (this.autoplay) this.startAutoplay();
    }

    disconnectedCallback() {
      this.stopAutoplay();
    }

    goToSlide(index) {
      if (index === this.currentIndex || this.isTransitioning) return;
      this.isTransitioning = true;

      const prev = this.slides[this.currentIndex];
      const next = this.slides[index];
      const prevDot = this.dots[this.currentIndex];
      const nextDot = this.dots[index];

      if (prev) {
        prev.classList.remove('hero-slider__slide--active');
        prev.setAttribute('aria-hidden', 'true');
      }
      if (prevDot) {
        prevDot.classList.remove('hero-slider__dot--active');
        prevDot.setAttribute('aria-selected', 'false');
        // Reset animation by cloning the progress circle
        const circle = prevDot.querySelector('.hero-slider__dot-progress');
        if (circle) {
          circle.style.animation = 'none';
          circle.offsetHeight; // reflow
          circle.style.animation = '';
        }
      }

      this.currentIndex = index;

      if (next) {
        next.classList.add('hero-slider__slide--active');
        next.setAttribute('aria-hidden', 'false');
      }
      if (nextDot) {
        nextDot.classList.add('hero-slider__dot--active');
        nextDot.setAttribute('aria-selected', 'true');
      }

      setTimeout(() => { this.isTransitioning = false; }, 700);

      if (this.autoplay) {
        this.stopAutoplay();
        this.startAutoplay();
      }
    }

    next() {
      this.goToSlide((this.currentIndex + 1) % this.totalSlides);
    }

    prev() {
      this.goToSlide((this.currentIndex - 1 + this.totalSlides) % this.totalSlides);
    }

    startAutoplay() {
      if (!this.autoplay || this.totalSlides <= 1) return;
      this.stopAutoplay();
      this.autoplayTimer = setInterval(() => this.next(), this.speed);
    }

    stopAutoplay() {
      if (this.autoplayTimer) {
        clearInterval(this.autoplayTimer);
        this.autoplayTimer = null;
      }
    }
  }

  if (!customElements.get('hero-slider')) {
    customElements.define('hero-slider', HeroSlider);
  }
{% endjavascript %}

{% schema %}
{
  "name": "Hero Slider",
  "tag": "section",
  "class": "hero-wrapper section-wrapper",
  "blocks": [
    { "type": "@theme" },
    { "type": "text" },
    { "type": "button" },
    { "type": "logo" },
    { "type": "jumbo-text" },
    { "type": "spacer" },
    { "type": "group" },
    { "type": "_marquee" }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Slides"
    },
    {
      "type": "range",
      "id": "slides_count",
      "label": "Número de slides",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 1
    },
    {
      "type": "header",
      "content": "Slide 1"
    },
    {
      "type": "image_picker",
      "id": "slide_1_image_desktop",
      "label": "Imagen desktop"
    },
    {
      "type": "image_picker",
      "id": "slide_1_image_mobile",
      "label": "Imagen mobile"
    },
    {
      "type": "url",
      "id": "slide_1_link",
      "label": "Enlace"
    },
    {
      "type": "checkbox",
      "id": "slide_1_open_in_new_tab",
      "label": "Abrir en nueva pestaña",
      "default": false
    },
    {
      "type": "header",
      "content": "Slide 2",
      "visible_if": "{{ section.settings.slides_count >= 2 }}"
    },
    {
      "type": "image_picker",
      "id": "slide_2_image_desktop",
      "label": "Imagen desktop",
      "visible_if": "{{ section.settings.slides_count >= 2 }}"
    },
    {
      "type": "image_picker",
      "id": "slide_2_image_mobile",
      "label": "Imagen mobile",
      "visible_if": "{{ section.settings.slides_count >= 2 }}"
    },
    {
      "type": "url",
      "id": "slide_2_link",
      "label": "Enlace",
      "visible_if": "{{ section.settings.slides_count >= 2 }}"
    },
    {
      "type": "checkbox",
      "id": "slide_2_open_in_new_tab",
      "label": "Abrir en nueva pestaña",
      "default": false,
      "visible_if": "{{ section.settings.slides_count >= 2 }}"
    },
    {
      "type": "header",
      "content": "Slide 3",
      "visible_if": "{{ section.settings.slides_count >= 3 }}"
    },
    {
      "type": "image_picker",
      "id": "slide_3_image_desktop",
      "label": "Imagen desktop",
      "visible_if": "{{ section.settings.slides_count >= 3 }}"
    },
    {
      "type": "image_picker",
      "id": "slide_3_image_mobile",
      "label": "Imagen mobile",
      "visible_if": "{{ section.settings.slides_count >= 3 }}"
    },
    {
      "type": "url",
      "id": "slide_3_link",
      "label": "Enlace",
      "visible_if": "{{ section.settings.slides_count >= 3 }}"
    },
    {
      "type": "checkbox",
      "id": "slide_3_open_in_new_tab",
      "label": "Abrir en nueva pestaña",
      "default": false,
      "visible_if": "{{ section.settings.slides_count >= 3 }}"
    },
    {
      "type": "header",
      "content": "Slide 4",
      "visible_if": "{{ section.settings.slides_count >= 4 }}"
    },
    {
      "type": "image_picker",
      "id": "slide_4_image_desktop",
      "label": "Imagen desktop",
      "visible_if": "{{ section.settings.slides_count >= 4 }}"
    },
    {
      "type": "image_picker",
      "id": "slide_4_image_mobile",
      "label": "Imagen mobile",
      "visible_if": "{{ section.settings.slides_count >= 4 }}"
    },
    {
      "type": "url",
      "id": "slide_4_link",
      "label": "Enlace",
      "visible_if": "{{ section.settings.slides_count >= 4 }}"
    },
    {
      "type": "checkbox",
      "id": "slide_4_open_in_new_tab",
      "label": "Abrir en nueva pestaña",
      "default": false,
      "visible_if": "{{ section.settings.slides_count >= 4 }}"
    },
    {
      "type": "header",
      "content": "Slide 5",
      "visible_if": "{{ section.settings.slides_count >= 5 }}"
    },
    {
      "type": "image_picker",
      "id": "slide_5_image_desktop",
      "label": "Imagen desktop",
      "visible_if": "{{ section.settings.slides_count >= 5 }}"
    },
    {
      "type": "image_picker",
      "id": "slide_5_image_mobile",
      "label": "Imagen mobile",
      "visible_if": "{{ section.settings.slides_count >= 5 }}"
    },
    {
      "type": "url",
      "id": "slide_5_link",
      "label": "Enlace",
      "visible_if": "{{ section.settings.slides_count >= 5 }}"
    },
    {
      "type": "checkbox",
      "id": "slide_5_open_in_new_tab",
      "label": "Abrir en nueva pestaña",
      "default": false,
