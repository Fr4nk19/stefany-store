{{ 'main-job.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign job = metaobject
  assign has_hero_image = false
  if job.hero_image != blank
    assign has_hero_image = true
  endif
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section class="job-detail color-{{ section.settings.color_scheme }}">
  <header class="job-detail__hero {% if has_hero_image %}job-detail__hero--with-image{% endif %}">
    {%- if has_hero_image -%}
      <div class="job-detail__hero-media">
        {{ job.hero_image | image_url: width: 1800 | image_tag: loading: 'eager', widths: '600,900,1200,1800', sizes: '100vw' }}
        <div class="job-detail__hero-overlay" style="background: {{ section.settings.overlay_color }};"></div>
      </div>
    {%- endif -%}
    <div class="job-detail__hero-content">
      <h1 class="job-detail__title">{{ job.title | default: 'Job title' }}</h1>
      <a href="#apply" class="button job-detail__apply">{{ section.settings.apply_label }}</a>
    </div>
  </header>

  <div class="job-detail__body page-width-content">
    <dl class="job-detail__info job-detail__info--stack">
      {%- if job.title != blank -%}
        <div class="job-detail__info-row">
          <dt>{{ section.settings.role_label }}</dt>
          <dd>{{ job.title }}</dd>
        </div>
      {%- endif -%}
      {%- if job.reports_into != blank -%}
        <div class="job-detail__info-row">
          <dt>{{ section.settings.reports_label }}</dt>
          <dd>{{ job.reports_into }}</dd>
        </div>
      {%- endif -%}
      {%- if job.contract_type != blank -%}
        <div class="job-detail__info-row">
          <dt>{{ section.settings.contract_label }}</dt>
          <dd>{{ job.contract_type }}</dd>
        </div>
      {%- endif -%}
      {%- if job.location != blank -%}
        <div class="job-detail__info-row">
          <dt>{{ section.settings.location_label }}</dt>
          <dd>{{ job.location }}</dd>
        </div>
      {%- endif -%}
    </dl>

    {%- if job.about_us != blank -%}
      <section class="job-detail__section">
        <h2 class="job-detail__heading">{{ section.settings.about_us_heading }}</h2>
        <div class="job-detail__rte">{{ job.about_us }}</div>
      </section>
    {%- endif -%}

    {%- if job.purpose_mission != blank -%}
      <section class="job-detail__section">
        <h2 class="job-detail__heading">{{ section.settings.mission_heading }}</h2>
        <div class="job-detail__rte">{{ job.purpose_mission }}</div>
      </section>
    {%- endif -%}

    {%- if job.benefits != blank -%}
      <section class="job-detail__section">
        <h2 class="job-detail__heading">{{ section.settings.benefits_heading }}</h2>
        <div class="job-detail__rte">{{ job.benefits }}</div>
      </section>
    {%- endif -%}

    {%- if job.team != blank -%}
      <section class="job-detail__section">
        <h2 class="job-detail__heading">{{ section.settings.team_heading }}</h2>
        <div class="job-detail__rte">{{ job.team }}</div>
      </section>
    {%- endif -%}

    {%- if job.about_you != blank -%}
      <section class="job-detail__section">
        <h2 class="job-detail__heading">{{ section.settings.about_you_heading }}</h2>
        <div class="job-detail__rte">{{ job.about_you }}</div>
      </section>
    {%- endif -%}

    {%- if job.responsibilities != blank -%}
      <section class="job-detail__section">
        <h2 class="job-detail__heading">{{ section.settings.responsibilities_heading }}</h2>
        <div class="job-detail__rte">{{ job.responsibilities }}</div>
      </section>
    {%- endif -%}

    {%- if job.requirements != blank -%}
      <section class="job-detail__section">
        <h2 class="job-detail__heading">{{ section.settings.requirements_heading }}</h2>
        <div class="job-detail__rte">{{ job.requirements }}</div>
      </section>
    {%- endif -%}

    {%- if job.equality_inclusion != blank -%}
      <section class="job-detail__section">
        <h2 class="job-detail__heading">{{ section.settings.equality_heading }}</h2>
        <div class="job-detail__rte">{{ job.equality_inclusion }}</div>
      </section>
    {%- endif -%}

    <dl class="job-detail__info job-detail__info--table">
      {%- if job.department != blank -%}
        <div class="job-detail__info-row">
          <dt>{{ section.settings.department_label }}</dt>
          <dd>{{ job.department }}</dd>
        </div>
      {%- endif -%}
      {%- if job.location != blank -%}
        <div class="job-detail__info-row">
          <dt>{{ section.settings.locations_label }}</dt>
          <dd>{{ job.location }}</dd>
        </div>
      {%- endif -%}
      {%- if job.remote_status != blank -%}
        <div class="job-detail__info-row">
          <dt>{{ section.settings.remote_label }}</dt>
          <dd>{{ job.remote_status }}</dd>
        </div>
      {%- endif -%}
      {%- if job.employment_type != blank -%}
        <div class="job-detail__info-row">
          <dt>{{ section.settings.employment_label }}</dt>
          <dd>{{ job.employment_type }}</dd>
        </div>
      {%- endif -%}
    </dl>

    <div id="apply" class="job-detail__apply-form">
      <h2 class="job-detail__heading">{{ section.settings.apply_form_heading }}</h2>
      {%- form 'contact', class: 'job-detail__form' -%}
        {%- if form.posted_successfully? -%}
          <p class="job-detail__form-success">{{ section.settings.form_success_text }}</p>
        {%- endif -%}
        {%- if form.errors -%}
          <ul class="job-detail__form-errors">
            {%- for field in form.errors -%}
              <li>{{ form.errors.messages[field] }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <input type="hidden" name="contact[job_title]" value="{{ job.title | escape }}">

        <div class="job-detail__form-row">
          <label for="JobContact-Name">{{ section.settings.form_name_label }}</label>
          <input type="text" id="JobContact-Name" name="contact[name]" required>
        </div>
        <div class="job-detail__form-row">
          <label for="JobContact-Email">{{ section.settings.form_email_label }}</label>
          <input type="email" id="JobContact-Email" name="contact[email]" required>
        </div>
        <div class="job-detail__form-row">
          <label for="JobContact-Phone">{{ section.settings.form_phone_label }}</label>
          <input type="tel" id="JobContact-Phone" name="contact[phone]">
        </div>
        <div class="job-detail__form-row">
          <label for="JobContact-Body">{{ section.settings.form_message_label }}</label>
          <textarea id="JobContact-Body" name="contact[body]" rows="6"></textarea>
        </div>
        <button type="submit" class="button job-detail__form-submit">
          {{ section.settings.form_submit_label }}
        </button>
      {%- endform -%}
    </div>

    {%- if section.settings.cta_heading != blank or section.settings.cta_button_label != blank -%}
      <div class="job-detail__cta">
        {%- if section.settings.cta_heading != blank -%}
          <h2 class="job-detail__cta-heading">{{ section.settings.cta_heading }}</h2>
        {%- endif -%}
        {%- if section.settings.cta_button_label != blank and section.settings.cta_button_link != blank -%}
          <a href="{{ section.settings.cta_button_link }}" class="button job-detail__cta-button">
            {{ section.settings.cta_button_label }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
