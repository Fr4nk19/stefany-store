      "label": "Purpose and Mission",
      "default": "Our Purpose and Mission"
    },
    {
      "type": "text",
      "id": "benefits_heading",
      "label": "Benefits",
      "default": "Our Benefits"
    },
    {
      "type": "text",
      "id": "team_heading",
      "label": "The Team",
      "default": "The Team"
    },
    {
      "type": "text",
      "id": "about_you_heading",
      "label": "About you",
      "default": "About you"
    },
    {
      "type": "text",
      "id": "responsibilities_heading",
      "label": "Responsibilities",
      "default": "You'll be responsible for:"
    },
    {
      "type": "text",
      "id": "requirements_heading",
      "label": "Requirements",
      "default": "You'll need to have:"
    },
    {
      "type": "text",
      "id": "equality_heading",
      "label": "Equality",
      "default": "Equality, Diversity, and Inclusion"
    },
    {
      "type": "header",
      "content": "Summary table labels"
    },
    {
      "type": "text",
      "id": "department_label",
      "label": "Department label",
      "default": "Department"
    },
    {
      "type": "text",
      "id": "locations_label",
