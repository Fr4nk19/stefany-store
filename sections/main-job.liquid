      "default": "Remote status"
    },
    {
      "type": "text",
      "id": "employment_label",
      "label": "Employment type label",
      "default": "Employment type"
    },
    {
      "type": "header",
      "content": "Application form"
    },
    {
      "type": "text",
      "id": "apply_form_heading",
