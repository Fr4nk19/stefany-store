{{ 'job-info.css' | asset_url | stylesheet_tag }}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="section page-width-content color-{{ section.settings.color_scheme }}">
  <div
    class="job-info job-info--{{ section.settings.layout }}"
    style="
      padding-block-start: {{ section.settings.padding-block-start }}px;
      padding-block-end: {{ section.settings.padding-block-end }}px;
    "
  >
    {%- if section.settings.heading != blank -%}
      <h2 class="job-info__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <dl class="job-info__list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'info_pair' -%}
          <div class="job-info__row" {{ block.shopify_attributes }}>
            <dt class="job-info__label">{{ block.settings.label }}</dt>
            <dd class="job-info__value">{{ block.settings.value }}</dd>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </dl>
  </div>
</div>

{% schema %}
{
  "name": "Job info",
  "class": "section-wrapper",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "stack", "label": "Stacked rows" },
        { "value": "table", "label": "Bordered table" }
      ],
      "default": "stack"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "info_pair",
      "name": "Info row",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Label" },
        { "type": "text", "id": "value", "label": "Value", "default": "Value" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Job info",
      "blocks": [
        { "type": "info_pair", "settings": { "label": "Role", "value": "Senior Loyalty Manager" } },
        { "type": "info_pair", "settings": { "label": "Reports into", "value": "Head of CRM" } },
        { "type": "info_pair", "settings": { "label": "Contract Type", "value": "Full Time" } },
        { "type": "info_pair", "settings": { "label": "Location", "value": "Hybrid, working 3 days a week in our office" } }
      ]
    }
  ]
}
{% endschema %}
