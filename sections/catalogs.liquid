{% liquid
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign columns = section.settings.columns
  assign mobile_columns = section.settings.mobile_columns
  assign card_ratio = section.settings.card_ratio
  assign show_button = section.settings.show_button
  assign button_text = section.settings.button_text
  assign open_in_new_tab = section.settings.open_in_new_tab
  assign section_id = section.id
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<div
  class="catalogs section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style"
  style="
    {%- render 'spacing-style', settings: section.settings -%}
    --catalogs-columns: {{ columns }};
    --catalogs-columns-mobile: {{ mobile_columns }};
    --catalogs-gap: {{ section.settings.columns_gap }}px;
    --catalogs-row-gap: {{ section.settings.rows_gap }}px;
    --catalogs-ratio: {{ card_ratio }};
  "
  data-section-id="{{ section_id }}"
>
  {% if heading != blank or subheading != blank %}
    <div class="catalogs__header">
      {% if heading != blank %}
        <h2 class="catalogs__title">{{ heading }}</h2>
      {% endif %}
      {% if subheading != blank %}
        <p class="catalogs__subtitle">{{ subheading }}</p>
      {% endif %}
    </div>
  {% endif %}

  {% if section.blocks.size > 0 %}
    <div class="catalogs__grid">
      {% for block in section.blocks %}
        {% liquid
          assign image = block.settings.image
          assign title = block.settings.title
          assign description = block.settings.description
          assign link = block.settings.link
          assign badge = block.settings.badge
        %}

        <div class="catalogs__card" {{ block.shopify_attributes }}>
          {% if link != blank %}
            <a
              href="{{ link }}"
              class="catalogs__card-link"
              {% if open_in_new_tab %}target="_blank" rel="noopener"{% endif %}
              {% if title != blank %}aria-label="{{ title | escape }}"{% endif %}
            >
          {% else %}
            <div class="catalogs__card-link catalogs__card-link--inactive">
          {% endif %}

            <div class="catalogs__card-media">
              {% if image != blank %}
                {{ image | image_url: width: 1200 | image_tag:
                  loading: 'lazy',
                  class: 'catalogs__card-image',
                  widths: '400,600,800,1000,1200',
                  sizes: '(min-width: 750px) calc((100vw - 2 * var(--page-margin)) / var(--catalogs-columns)), calc((100vw - 2 * var(--page-margin)) / var(--catalogs-columns-mobile))'
                }}
              {% else %}
                {{ 'collection-1' | placeholder_svg_tag: 'catalogs__card-image catalogs__card-image--placeholder' }}
              {% endif %}

              {% if badge != blank %}
                <span class="catalogs__card-badge">{{ badge }}</span>
              {% endif %}

              {% if show_button and link != blank %}
                <span class="catalogs__card-button">{{ button_text | default: 'VER CATÁLOGO' }}</span>
              {% endif %}
            </div>

            {% if title != blank or description != blank %}
              <div class="catalogs__card-content">
                {% if title != blank %}
                  <h3 class="catalogs__card-title">{{ title }}</h3>
                {% endif %}
                {% if description != blank %}
                  <p class="catalogs__card-description">{{ description }}</p>
                {% endif %}
              </div>
            {% endif %}

          {% if link != blank %}
            </a>
          {% else %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  {% else %}
    <div class="catalogs__empty">
      <p>{{ 'Agrega catálogos desde el editor del tema.' }}</p>
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .catalogs {
    position: relative;
  }

  .catalogs__header {
    text-align: center;
    margin-bottom: 32px;
  }

  .catalogs__title {
    font-family: var(--font-heading--family);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin: 0 0 8px;
  }

  .catalogs__subtitle {
    font-family: var(--font-body--family);
    font-size: 1rem;
    margin: 0;
    opacity: 0.8;
  }

  .catalogs__grid {
    display: grid;
    grid-template-columns: repeat(var(--catalogs-columns-mobile, 1), minmax(0, 1fr));
    column-gap: var(--catalogs-gap, 16px);
    row-gap: var(--catalogs-row-gap, 32px);
  }

  @media screen and (min-width: 750px) {
    .catalogs__grid {
      grid-template-columns: repeat(var(--catalogs-columns, 2), minmax(0, 1fr));
    }
  }

  .catalogs__card {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .catalogs__card-link,
  .catalogs__card-link--inactive {
    display: flex;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
    height: 100%;
  }

  .catalogs__card-media {
    position: relative;
    overflow: hidden;
    background: #1a1a1a;
    aspect-ratio: var(--catalogs-ratio, 3 / 4);
  }

  .catalogs__card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.45s ease;
  }

  .catalogs__card-link:hover .catalogs__card-image {
    transform: scale(1.04);
  }

  .catalogs__card-image--placeholder {
    background: #e5e5e5;
    color: #888;
  }

  .catalogs__card-badge {
    position: absolute;
    top: 16px;
    left: 16px;
    background: #fff;
    color: #000;
    font-family: var(--font-body--family);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 6px 12px;
    z-index: 2;
  }

  .catalogs__card-button {
    position: absolute;
    bottom: 16px;
    left: 50%;
    transform: translateX(-50%) translateY(10px);
    background: #fff;
    color: #000;
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 10px 22px;
    opacity: 0;
    transition: opacity 0.25s ease, transform 0.25s ease, background 0.2s ease, color 0.2s ease;
    z-index: 2;
    white-space: nowrap;
  }

  .catalogs__card-link:hover .catalogs__card-button,
  .catalogs__card-link:focus-visible .catalogs__card-button {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  .catalogs__card-button:hover {
    background: #000;
    color: #fff;
  }

  .catalogs__card-content {
    padding: 16px 4px 0;
    text-align: center;
  }

  .catalogs__card-title {
    font-family: var(--font-heading--family);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0 0 6px;
  }

  .catalogs__card-description {
    font-family: var(--font-body--family);
    font-size: 0.9rem;
    line-height: 1.45;
    margin: 0;
    opacity: 0.85;
  }

  .catalogs__empty {
    text-align: center;
    padding: 48px 16px;
    opacity: 0.65;
  }

  @media screen and (max-width: 749px) {
    .catalogs__card-button {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
      font-size: 0.7rem;
      padding: 8px 16px;
    }

    .catalogs__card-title {
      font-size: 0.95rem;
    }

    .catalogs__card-description {
      font-size: 0.85rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Catálogos",
  "class": "catalogs-section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "CATÁLOGOS"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "Descubre nuestras colecciones"
    },
    {
      "type": "header",
      "content": "Diseño"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columnas en escritorio",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Columnas en móvil",
      "options": [
        { "value": "1", "label": "1 columna" },
        { "value": "2", "label": "2 columnas" }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "card_ratio",
      "label": "Proporción de la imagen",
      "options": [
        { "value": "1 / 1", "label": "Cuadrada (1:1)" },
        { "value": "3 / 4", "label": "Vertical (3:4)" },
        { "value": "2 / 3", "label": "Vertical alta (2:3)" },
        { "value": "9 / 16", "label": "Móvil (9:16)" },
        { "value": "4 / 5", "label": "Retrato (4:5)" },
        { "value": "4 / 3", "label": "Horizontal (4:3)" },
        { "value": "16 / 9", "label": "Panorámica (16:9)" }
      ],
      "default": "3 / 4"
    },
    {
      "type": "range",
      "id": "columns_gap",
      "label": "Espacio entre columnas",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "rows_gap",
      "label": "Espacio entre filas",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Botón"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Mostrar botón al pasar el cursor",
      "default": true
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Texto del botón",
      "default": "VER CATÁLOGO"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Abrir enlaces en una nueva pestaña",
      "default": true
    },
    {
      "type": "header",
      "content": "Sección"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Ancho de la sección",
      "options": [
        { "value": "page-width", "label": "Ancho de página" },
        { "value": "full-width", "label": "Ancho completo" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Superior",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Inferior",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "catalog",
      "name": "Catálogo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen del catálogo",
          "info": "Sube la portada del catálogo (recomendado 1200x1600 px)."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Catálogo de temporada"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Descripción corta"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Etiqueta",
          "info": "Por ejemplo: NUEVO, MAYO 2026"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace del catálogo",
          "info": "Sube el PDF en Configuración > Archivos de tu tienda, copia su URL y pégala aquí. También puedes enlazar a una colección o página."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Catálogos",
      "category": "Storytelling",
      "blocks": [
        {
          "type": "catalog",
          "settings": {
            "title": "Mujer",
            "description": "Nueva colección",
            "badge": "MAYO 2026"
          }
        },
        {
          "type": "catalog",
          "settings": {
            "title": "Hombre",
            "description": "Para el hombre que impulsa",
            "badge": "MAYO 2026"
          }
        },
        {
          "type": "catalog",
          "settings": {
            "title": "Mayorista",
            "description": "Sé mayorista con pocas prendas"
          }
        }
      ]
    }
  ]
}
{% endschema %}
