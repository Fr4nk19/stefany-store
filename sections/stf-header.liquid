      <a href="/" aria-label="{{ shop.name }}">
        {{ section.settings.logo | image_url: width: 140 | image_tag: class: 'header__logo-img', style: 'max-width:100px;height:auto;', alt: shop.name }}
      </a>
    {%- else -%}
      <a href="/" style="font-size:18px;font-weight:700;color:#1a1a1a;text-decoration:none;">{{ shop.name }}</a>
    {%- endif -%}
    <button class="mobile-drawer__close" id="stfDrawerClose" aria-label="Close menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>

  <div class="mobile-drawer__body">
    <ul class="mobile-drawer__nav">
      {%- for block in section.blocks -%}
        {%- if block.type == 'menu_item' -%}
          {%- assign menu_slug = block.settings.title | handleize -%}
          {%- assign owner_index = forloop.index0 -%}

          {%- comment -%} Find where the next menu_item starts {%- endcomment -%}
          {%- assign next_owner = section.blocks.size -%}
          {%- assign found_self = false -%}
          {%- for b in section.blocks -%}
            {%- if b.type == 'menu_item' -%}
              {%- if found_self -%}
                {%- assign next_owner = forloop.index0 -%}
                {%- break -%}
              {%- endif -%}
              {%- if b.id == block.id -%}
                {%- assign found_self = true -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}

          {%- comment -%} Check if this menu item has children {%- endcomment -%}
          {%- assign has_children = false -%}
          {%- if block.settings.menu_type != 'link_only' -%}
            {%- for child in section.blocks -%}
              {%- assign ci = forloop.index0 -%}
              {%- if ci > owner_index and ci < next_owner -%}
                {%- assign has_children = true -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}

          <li class="mobile-drawer__nav-item" {% if has_children %}data-accordion{% endif %}>
            {%- if has_children -%}
              <a href="#" class="mobile-drawer__nav-link" data-accordion-toggle>
                {{ block.settings.title }}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>
              </a>
              <div class="mobile-drawer__submenu">
                {%- if block.settings.menu_type == 'megamenu_shop' -%}
                  {%- comment -%} Render linklist columns {%- endcomment -%}
                  {%- for child in section.blocks -%}
                    {%- assign ci = forloop.index0 -%}
                    {%- if ci > owner_index and ci < next_owner and child.type == 'menu_linklist' -%}
                      <div class="mobile-drawer__submenu-group">
                        {%- if child.settings.heading != blank -%}
                          <div class="mobile-drawer__submenu-title">{{ child.settings.heading }}</div>
                        {%- endif -%}
                        {%- assign ll = child.settings.linklist -%}
                        {%- if ll != blank -%}
                          {%- for link in linklists[ll].links -%}
                            <a href="{{ link.url }}" class="mobile-drawer__submenu-link">{{ link.title }}</a>
                          {%- endfor -%}
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  {%- endfor -%}

                {%- elsif block.settings.menu_type == 'megamenu_activities' -%}
                  {%- comment -%} Render activity cards {%- endcomment -%}
                  <div class="mobile-drawer__activity-list">
                    {%- for child in section.blocks -%}
                      {%- assign ci = forloop.index0 -%}
                      {%- if ci > owner_index and ci < next_owner and child.type == 'activity_card' -%}
                        <a href="{{ child.settings.url | default: '#' }}" class="mobile-drawer__activity-item">
                          {%- if child.settings.image != blank -%}
                            {{ child.settings.image | image_url: width: 96 | image_tag: loading: 'lazy' }}
                          {%- else -%}
                            <div class="mobile-drawer__activity-placeholder"></div>
                          {%- endif -%}
                          {{ child.settings.title }}
                        </a>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                  {%- if block.settings.shop_all_url != blank -%}
                    <div class="mobile-drawer__submenu-footer">
                      <a href="{{ block.settings.shop_all_url }}" class="mobile-drawer__shop-all">SHOP ALL</a>
                    </div>
                  {%- endif -%}
                {%- endif -%}
              </div>
            {%- else -%}
              <a href="{{ block.settings.url | default: '#' }}" class="mobile-drawer__nav-link">
                {{ block.settings.title }}
              </a>
            {%- endif -%}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>

  <div class="mobile-drawer__footer">
    <div class="mobile-drawer__footer-links">
      <a href="{{ routes.search_url }}" class="mobile-drawer__footer-link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        Search
